{
  "name": "nuxt-toc",
  "version": "3.0.0",
  "description": "A Nuxt module for Table of Contents (TOC) compatible with @nuxt/content v2 and v3",
  "repository": "https://github.com/thaikolja/nuxt-toc",
  "author": "Kolja Nolte",
  "keywords": [
    "Nuxt",
    "TOC",
    "Table of Contents",
    "Nuxt Content"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "bun run dev:v3",
    "dev:v3": "nuxi dev playgrounds/content-v3 --port 3000",
    "dev:v2": "nuxi dev playgrounds/content-v2 --port 3001",
    "dev:build": "bun run dev:build:v3 && bun run dev:build:v2",
    "dev:build:v3": "nuxi build playgrounds/content-v3",
    "dev:build:v2": "nuxi build playgrounds/content-v2",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && bun run playgrounds:install && bun run playgrounds:prepare",
    "playgrounds:install": "bun install --cwd playgrounds/content-v3 && bun install --cwd playgrounds/content-v2",
    "playgrounds:prepare": "nuxi prepare playgrounds/content-v3 && nuxi prepare playgrounds/content-v2",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "bun run lint && bun run test && bun run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "peerDependencies": {
    "@nuxt/content": "^2.0.0 || ^3.0.0",
    "nuxt": "^3.16.0 || ^4.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "^24.3.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.0",
    "jiti": "^2.6.0",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.0",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.0.0"
  }
}
